# VoCo Backend Environment Variables
# Copy this file to .env and fill in your values before running.

# Required: Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Database URL (defaults to local SQLite)
# For production use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/voco

# Optional: Redis URL (defaults to local Redis)
# REDIS_URL=redis://localhost:6379/0
